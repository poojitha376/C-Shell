+// (scheduler_test.c's own workload never varies nice, so without this
+// there's no way to show CFS or the learned RL policy behaving differently
+// from a nice-blind policy). Clamped to the same [-20,19] range CFS's
+// nice_to_weight table is indexed over.
+uint64
+sys_setnice(void)
+{
+  int pid, nice;
+  struct proc *p;
+
+  argint(0, &pid);
+  argint(1, &nice);
+  if (nice < -20)
+    nice = -20;
+  if (nice > 19)
+    nice = 19;
+
+  extern struct proc proc[];
+  for (p = proc; p < &proc[NPROC]; p++) {
+    acquire(&p->lock);
+    if (p->pid == pid && p->state != UNUSED) {
+      p->nice = nice;
+      release(&p->lock);
+      return 0;
+    }
+    release(&p->lock);
+  }
+  return -1;
+}
