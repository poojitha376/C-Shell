+#if defined(SCHEDULER_FCFS)
+// Selects the RUNNABLE process with the earliest creation time. Runs it to
+// completion (trap.c suppresses the timer-tick yield() under this policy,
+// so this loop only regains control when the process blocks or exits).
+static struct proc *
+pick_fcfs(void)
+{
+  struct proc *p, *best = 0;
+  for (p = proc; p < &proc[NPROC]; p++) {
+    acquire(&p->lock);
+    if (p->state == RUNNABLE) {
+      if (best == 0 || p->ctime < best->ctime) {
+        if (best)
+          release(&best->lock);
+        best = p; // keep best->lock held
+        continue;
+      }
+    }
+    release(&p->lock);
+  }
+  return best; // returned with best->lock held, or 0
+}
+#endif
+
+#if defined(SCHEDULER_CFS)
+// Selects the RUNNABLE process with the lowest vruntime, sized time_slice =
+// max(CFS_MIN_SLICE, CFS_TARGET_LATENCY / num_runnable). No sorted runqueue
+// structure is kept - each decision does an O(n) scan-and-min over proc[],
+// which the spec itself permits and NPROC is small enough that this is not
+// a real cost. Three passes: count (silent - wfi wakes on every idle timer
+// tick too, and we must NOT log when there's actually nothing to schedule),
+// then the required per-tick vRuntime log for every runnable process, then
+// find-and-return the minimum.
+static struct proc *
+pick_cfs(void)
+{
+  struct proc *p, *best = 0;
+  int num_runnable = 0;
+
+  for (p = proc; p < &proc[NPROC]; p++) {
+    acquire(&p->lock);
+    if (p->state == RUNNABLE)
+      num_runnable++;
+    release(&p->lock);
+  }
+  if (num_runnable == 0)
+    return 0;
+
+  printk("[Scheduler Tick]\n");
+  for (p = proc; p < &proc[NPROC]; p++) {
+    acquire(&p->lock);
+    if (p->state == RUNNABLE) {
+      printk("PID: %d | vRuntime: %d\n", p->pid, (int)p->vruntime);
+    }
+    release(&p->lock);
+  }
+
+  int slice = CFS_TARGET_LATENCY / num_runnable;
+  if (slice < CFS_MIN_SLICE)
+    slice = CFS_MIN_SLICE;
+
+  for (p = proc; p < &proc[NPROC]; p++) {
+    acquire(&p->lock);
+    if (p->state == RUNNABLE) {
+      if (best == 0 || p->vruntime < best->vruntime) {
+        if (best)
+          release(&best->lock);
+        best = p; // keep best->lock held
+        continue;
+      }
+    }
+    release(&p->lock);
+  }
+
+  if (best) {
+    best->time_slice = slice;
+    best->ticks_in_slice = 0;
+    printk("--> Scheduling PID %d (lowest vRuntime)\n", best->pid);
+  }
+  return best; // returned with best->lock held, or 0
+}
+#endif
+
+#if defined(SCHEDULER_MLFQ)
+// True if some other RUNNABLE process sits in a strictly higher-priority
+// (lower-numbered) queue than `running` - used to preempt early instead of
+// waiting for the current queue's full slice, per spec 2(b).
+static int
+should_preempt_mlfq(struct proc *running)
+{
+  struct proc *p;
+  for (p = proc; p < &proc[NPROC]; p++) {
+    if (p == running)
+      continue;
+    acquire(&p->lock);
+    int hit = (p->state == RUNNABLE && p->mlfq_queue < running->mlfq_queue);
+    release(&p->lock);
+    if (hit)
+      return 1;
+  }
+  return 0;
+}
+
+// No per-queue linked lists are kept (same O(n) scan-and-filter approach as
+// CFS) - each decision scans proc[] for the RUNNABLE process(es) in the
+// lowest-numbered non-empty queue. Ties are broken by predicted CPU-burst
+// length first (shorter predicted burst gets a small SJF-flavored edge),
+// then by a rotating cursor so same-queue/same-prediction processes still
+// get fair round-robin turns (this also satisfies "queue 3 uses
+// round-robin" - it's just queue 3's *only* tie-break once bursts settle).
+static int mlfq_rr_cursor = 0;
+
+static struct proc *
+pick_mlfq(void)
+{
+  struct proc *p, *best = 0;
+  int num_runnable = 0;
+
+  acquire(&tickslock);
+  uint64 now = ticks;
+  release(&tickslock);
+  if (now - mlfq_last_boost >= MLFQ_BOOST_PERIOD) {
+    for (p = proc; p < &proc[NPROC]; p++) {
+      acquire(&p->lock);
+      if (p->state != UNUSED)
+        p->mlfq_queue = 0;
+      release(&p->lock);
+    }
+    mlfq_last_boost = now;
+  }
+
+  int min_q = MLFQ_NQUEUE;
+  for (p = proc; p < &proc[NPROC]; p++) {
+    acquire(&p->lock);
+    if (p->state == RUNNABLE) {
+      num_runnable++;
+      if (p->mlfq_queue < min_q)
+        min_q = p->mlfq_queue;
+    }
+    release(&p->lock);
+  }
+  if (num_runnable == 0)
+    return 0;
+
+  int best_burst = 0;
+  for (int i = 0; i < NPROC; i++) {
+    int idx = (mlfq_rr_cursor + i) % NPROC;
+    p = &proc[idx];
+    acquire(&p->lock);
+    if (p->state == RUNNABLE && p->mlfq_queue == min_q) {
+      if (best == 0 || p->predicted_burst < best_burst) {
+        if (best)
+          release(&best->lock);
+        best = p; // keep best->lock held
+        best_burst = p->predicted_burst;
+        continue;
+      }
+    }
+    release(&p->lock);
+  }
+
+  if (best) {
+    best->time_slice = mlfq_slice[best->mlfq_queue];
+    best->ticks_in_slice = 0;
+    best->mlfq_slice_exhausted = 0;
+    mlfq_rr_cursor = (best - proc + 1) % NPROC;
+  }
+  return best; // returned with best->lock held, or 0
+}
+#endif
+
+#if defined(SCHEDULER_RL)
+// Learned linear scoring policy: score = RL_W_VRUNTIME*vruntime +
+// RL_W_NICE*nice (lowest score runs next). Weights were distilled offline
+// via black-box policy search against a simulated average-waiting-time
+// reward - see xv6/tools/train_rl_scheduler.py and report.md for the full
+// training methodology and a held-out-set comparison against a
+// CFS-equivalent (vruntime-only) baseline. The search zeroed out the
+// waiting-time term entirely (RL_W_WAIT=0), so it's omitted here rather
+// than computed and multiplied by zero. Slice sizing reuses CFS's
+// target-latency formula, since the learned policy only concerns itself
+// with *which* process runs next, not how long its turn should be.
+#define RL_W_VRUNTIME 1
+#define RL_W_NICE 109
+
+static struct proc *
+pick_rl(void)
+{
+  struct proc *p, *best = 0;
+  long best_score = 0;
+  int num_runnable = 0;
+
+  for (p = proc; p < &proc[NPROC]; p++) {
+    acquire(&p->lock);
+    if (p->state == RUNNABLE) {
+      num_runnable++;
+      p->weight = nice_to_weight[p->nice + 20];
+      long score = (long)RL_W_VRUNTIME * (long)p->vruntime +
+                    (long)RL_W_NICE * (long)p->nice;
+      if (best == 0 || score < best_score) {
+        if (best)
+          release(&best->lock);
+        best = p; // keep best->lock held
+        best_score = score;
+        continue;
+      }
+    }
+    release(&p->lock);
+  }
+  if (num_runnable == 0)
+    return 0;
+
+  if (best) {
+    int slice = CFS_TARGET_LATENCY / num_runnable;
+    if (slice < CFS_MIN_SLICE)
+      slice = CFS_MIN_SLICE;
+    best->time_slice = slice;
+    best->ticks_in_slice = 0;
+  }
+  return best; // returned with best->lock held, or 0
+}
+#endif
+
+// Called from trap.c's timer-tick handlers (usertrap/kerneltrap) instead of
+// an unconditional yield() - each policy decides its own preemption cadence
+// here rather than always preempting every tick like vanilla round-robin.
+int
+should_yield_on_tick(void)
+{
+#if defined(SCHEDULER_FCFS)
+  // Non-preemptive: only reschedule when the running process blocks/exits.
+  return 0;
+#elif defined(SCHEDULER_CFS)
+  // Accrue vruntime for the tick just consumed (weight-normalized against
+  // NICE_0_WEIGHT), then preempt once the process's assigned slice for this
+  // scheduling round is used up.
+  struct proc *p = myproc();
+  // Keep weight in sync with nice (setnice() can change it between ticks -
+  // deriving weight from the table here rather than trusting a stale
+  // init-time copy keeps it correct without needing setnice to reach in and
+  // update every field itself).
+  p->weight = nice_to_weight[p->nice + 20];
+  p->vruntime += NICE_0_WEIGHT / p->weight;
+  p->ticks_in_slice++;
+  return p->ticks_in_slice >= p->time_slice;
+#elif defined(SCHEDULER_RL)
+  // Same vruntime accrual and slice-exhaustion cadence as CFS - the learned
+  // policy only changes *selection* (pick_rl), not the per-tick bookkeeping.
+  struct proc *p = myproc();
+  p->weight = nice_to_weight[p->nice + 20];
+  p->vruntime += NICE_0_WEIGHT / p->weight;
+  p->ticks_in_slice++;
+  return p->ticks_in_slice >= p->time_slice;
+#elif defined(SCHEDULER_MLFQ)
+  struct proc *p = myproc();
+  p->ticks_in_slice++;
+  if (p->ticks_in_slice >= p->time_slice) {
+    p->mlfq_slice_exhausted = 1; // yield() demotes on this flag
+    return 1;
+  }
+  if (should_preempt_mlfq(p)) {
+    p->mlfq_slice_exhausted = 0; // preempted early, not exhausted - no demotion
+    return 1;
+  }
+  return 0;
+#else
+  return 1; // vanilla round-robin cadence (also used as the MLFQ/RL
+            // fallback until their own branches are added)
+#endif
+}
